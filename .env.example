# Port HTTP server
PORT=3000

# Base URL publik — dipakai untuk generate snippet embed & direct chat link
PUBLIC_URL=http://localhost:3000

# Secret untuk JWT (WAJIB diganti di production, minimal 32 karakter acak)
JWT_SECRET=ganti-dengan-string-acak-panjang-di-production

# Lokasi file database SQLite
DATABASE_FILE=./data/nagalivechat.db

# Lokasi gambar unggahan (logo, banner). Default: folder uploads/ di samping database
UPLOAD_DIR=./data/uploads

# Set ke "production" saat deploy (mengaktifkan cookie secure)
NODE_ENV=development
