{
  "name": "nagalivechat",
  "version": "1.0.0",
  "private": true,
  "description": "NagaLiveChat — platform live chat multi-tenant dengan widget embed, direct chat link, dan agent workspace realtime.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server/index.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch server/index.js",
    "seed": "node --no-warnings=ExperimentalWarning server/db/seed.js",
    "reset": "node --no-warnings=ExperimentalWarning server/db/seed.js --reset"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1"
  }
}
